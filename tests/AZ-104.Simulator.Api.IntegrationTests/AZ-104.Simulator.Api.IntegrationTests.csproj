<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Simulator.Api.IntegrationTests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="MSTest" Version="4.3.3" />
    <PackageReference Include="Verify.MSTest" Version="32.0.0" />
    <!-- Stesso pin del progetto di unit test: dalla 8.0 la licenza non e' piu' gratuita. -->
    <PackageReference Include="FluentAssertions" Version="[7.0.0,8.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data/seed.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AZ-104.Simulator.Api/AZ-104.Simulator.Api.csproj" />
  </ItemGroup>

</Project>
